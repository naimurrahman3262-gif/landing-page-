# Mock API (MSW). "enabled" routes BFF → backend calls to src/mocks.
NEXT_PUBLIC_API_MOCKING=enabled
# Upstream backend the BFF proxies to (mocked when the flag above is enabled).
BACKEND_URL=https://backend.mock.winprofx.local
# Signs the httpOnly session cookie (HMAC-SHA256). ≥ 32 random chars. REQUIRED on Vercel
# when not mocking: set it in Project → Settings → Environment Variables, never commit it.
# SESSION_SECRET=
